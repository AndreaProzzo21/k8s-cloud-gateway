# ==============================================================================
# K8S GATEWAY - ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# SERVER SETTINGS
# ------------------------------------------------------------------------------

# The interface the server binds to. 
# Use 0.0.0.0 for Docker/K8s, 127.0.0.1 for local development.
GATEWAY_HOST=0.0.0.0

# Port through which expose the FastAPI backend.
GATEWAY_PORT=8000


# Extra CORS origins (comma-separated) if accessing from different domains.
# CORS_EXTRA_ORIGINS=https://dashboard.example.com,http://192.168.1.50

# ------------------------------------------------------------------------------
# AUTHENTICATION & SECURITY
# ------------------------------------------------------------------------------

# [CRITICAL] Master key for the Admin Console (/admin.html).
# Use a long random string. If missing, the gateway will refuse to start.
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
ADMIN_MASTER_KEY=

# [OPTIONAL] JWT signing key. 
# If empty, a volatile random key will be generated at each startup.
# (Users will be logged out if the container restarts).
JWT_SECRET_KEY=

# JWT Algorithm and expiration time (in hours).
JWT_SECRET_ALGORITHM=HS256
JWT_EXPIRE_HOURS=1

# ------------------------------------------------------------------------------
# PERSISTENCE & ENCRYPTION
# ------------------------------------------------------------------------------

# SQLite database path. 
# Relative to the app root (e.g., data/gateway.db points to /app/data/gateway.db)
DATABASE_URL=data/gateway.db

# [CRITICAL] Fernet key to encrypt K8s tokens and passwords in the database.
# ⚠️ WARNING: NEVER CHANGE THIS KEY AFTER THE FIRST SETUP.
# If you change or lose this key, all existing encrypted data in the database 
# (K8s tokens, passwords, CA certs) will become unreadable and lost.
#
# If empty, the gateway will generate one and save it in 'data/.encryption_key'.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=